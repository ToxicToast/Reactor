{
  "name": "@toxictoast/contracts-proto",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "contracts-proto",
    "tags": [
      "scope:contracts",
      "type:contracts"
    ],
    "targets": {
      "generate": {
        "command": "buf generate",
        "options": {
          "cwd": "libs/contracts/proto"
        }
      },
      "lint-proto": {
        "command": "buf lint",
        "options": {
          "cwd": "libs/contracts/proto"
        }
      },
      "breaking": {
        "command": "buf breaking --against '../../../.git#branch=main,subdir=libs/contracts/proto'",
        "options": {
          "cwd": "libs/contracts/proto"
        }
      }
    }
  },
  "dependencies": {}
}
