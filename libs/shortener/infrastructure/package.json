{
  "name": "@toxictoast/shortener-infrastructure",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "shortener-infrastructure",
    "tags": [
      "scope:shortener",
      "type:infrastructure"
    ],
    "targets": {
      "migration-generate": {
        "command": "tsx --env-file=libs/shortener/infrastructure/.env node_modules/typeorm/cli.js migration:generate -d libs/shortener/infrastructure/typeorm.data-source.ts libs/shortener/infrastructure/src/migrations/{args.name}"
      },
      "migration-run": {
        "command": "tsx --env-file=libs/shortener/infrastructure/.env node_modules/typeorm/cli.js migration:run -d libs/shortener/infrastructure/typeorm.data-source.ts"
      },
      "migration-revert": {
        "command": "tsx --env-file=libs/shortener/infrastructure/.env node_modules/typeorm/cli.js migration:revert -d libs/shortener/infrastructure/typeorm.data-source.ts"
      },
      "integration": {}
    }
  },
  "dependencies": {
    "@toxictoast/shared-persistence": "*",
    "@toxictoast/shared-system": "*",
    "@toxictoast/shortener-application": "*",
    "@toxictoast/shortener-domain": "*",
    "typeorm": "^1.1.2",
    "@toxictoast/shared-types": "*"
  },
  "devDependencies": {
    "@toxictoast/contracts-events": "*",
    "@toxictoast/shared-kernel": "*"
  }
}
