{
  "name": "@toxictoast/security-infrastructure",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "security-infrastructure",
    "tags": [
      "scope:security",
      "type:infrastructure"
    ],
    "targets": {
      "migration-generate": {
        "command": "tsx --env-file=libs/security/infrastructure/.env node_modules/typeorm/cli.js migration:generate -d libs/security/infrastructure/typeorm.data-source.ts libs/security/infrastructure/src/migrations/{args.name}"
      },
      "migration-run": {
        "command": "tsx --env-file=libs/security/infrastructure/.env node_modules/typeorm/cli.js migration:run -d libs/security/infrastructure/typeorm.data-source.ts"
      },
      "migration-revert": {
        "command": "tsx --env-file=libs/security/infrastructure/.env node_modules/typeorm/cli.js migration:revert -d libs/security/infrastructure/typeorm.data-source.ts"
      },
      "integration": {}
    }
  },
  "dependencies": {
    "@toxictoast/security-application": "*",
    "@toxictoast/security-domain": "*",
    "@toxictoast/shared-kernel": "*",
    "@toxictoast/shared-persistence": "*",
    "@toxictoast/shared-system": "*",
    "@toxictoast/shared-types": "*",
    "ioredis": "^6.0.0",
    "typeorm": "^1.1.2"
  }
}
