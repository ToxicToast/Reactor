{
  "name": "@toxictoast/twitch-infrastructure",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "twitch-infrastructure",
    "tags": [
      "scope:twitch",
      "type:infrastructure"
    ],
    "targets": {
      "migration-generate": {
        "command": "tsx --env-file=libs/twitch/infrastructure/.env node_modules/typeorm/cli.js migration:generate -d libs/twitch/infrastructure/typeorm.data-source.ts libs/twitch/infrastructure/src/migrations/{args.name}"
      },
      "migration-run": {
        "command": "tsx --env-file=libs/twitch/infrastructure/.env node_modules/typeorm/cli.js migration:run -d libs/twitch/infrastructure/typeorm.data-source.ts"
      },
      "migration-revert": {
        "command": "tsx --env-file=libs/twitch/infrastructure/.env node_modules/typeorm/cli.js migration:revert -d libs/twitch/infrastructure/typeorm.data-source.ts"
      },
      "integration": {}
    }
  },
  "dependencies": {
    "@toxictoast/shared-persistence": "*",
    "@toxictoast/shared-system": "*",
    "@toxictoast/shared-types": "*",
    "@toxictoast/shared-webhooks-infrastructure": "*",
    "@toxictoast/twitch-application": "*",
    "@toxictoast/twitch-domain": "*",
    "ioredis": "^5.11.1",
    "typeorm": "^1.1.2"
  }
}
