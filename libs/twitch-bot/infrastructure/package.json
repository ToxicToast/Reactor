{
  "name": "@toxictoast/twitch-bot-infrastructure",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "twitch-bot-infrastructure",
    "tags": [
      "scope:twitch-bot",
      "type:infrastructure"
    ],
    "targets": {
      "migration-generate": {
        "command": "tsx --env-file=libs/twitch-bot/infrastructure/.env node_modules/typeorm/cli.js migration:generate -d libs/twitch-bot/infrastructure/typeorm.data-source.ts libs/twitch-bot/infrastructure/src/migrations/{args.name}"
      },
      "migration-run": {
        "command": "tsx --env-file=libs/twitch-bot/infrastructure/.env node_modules/typeorm/cli.js migration:run -d libs/twitch-bot/infrastructure/typeorm.data-source.ts"
      },
      "migration-revert": {
        "command": "tsx --env-file=libs/twitch-bot/infrastructure/.env node_modules/typeorm/cli.js migration:revert -d libs/twitch-bot/infrastructure/typeorm.data-source.ts"
      },
      "integration": {}
    }
  },
  "dependencies": {
    "@toxictoast/contracts-events": "*",
    "@toxictoast/shared-kernel": "*",
    "@toxictoast/shared-persistence": "*",
    "@toxictoast/shared-system": "*",
    "@toxictoast/shared-types": "*",
    "@toxictoast/twitch-bot-application": "*",
    "@toxictoast/twitch-bot-domain": "*",
    "@twurple/api": "^8.2.0",
    "@twurple/auth": "^8.2.0",
    "@twurple/eventsub-base": "^8.2.0",
    "@twurple/eventsub-ws": "^8.2.0",
    "typeorm": "^1.1.2"
  }
}
