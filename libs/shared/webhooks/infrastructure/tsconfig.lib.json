{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../domain/tsconfig.lib.json"
    },
    {
      "path": "../application/tsconfig.lib.json"
    },
    {
      "path": "../../types/tsconfig.lib.json"
    },
    {
      "path": "../../system/tsconfig.lib.json"
    },
    {
      "path": "../../persistence/tsconfig.lib.json"
    },
    {
      "path": "../../kernel/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
