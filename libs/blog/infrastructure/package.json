{
  "name": "@toxictoast/blog-infrastructure",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "blog-infrastructure",
    "tags": [
      "scope:blog",
      "type:infrastructure"
    ],
    "targets": {
      "migration-generate": {
        "command": "tsx --env-file=libs/blog/infrastructure/.env node_modules/typeorm/cli.js migration:generate -d libs/blog/infrastructure/typeorm.data-source.ts libs/blog/infrastructure/src/migrations/{args.name}"
      },
      "migration-run": {
        "command": "tsx --env-file=libs/blog/infrastructure/.env node_modules/typeorm/cli.js migration:run -d libs/blog/infrastructure/typeorm.data-source.ts"
      },
      "migration-revert": {
        "command": "tsx --env-file=libs/blog/infrastructure/.env node_modules/typeorm/cli.js migration:revert -d libs/blog/infrastructure/typeorm.data-source.ts"
      },
      "integration": {
        "executor": "@nx/jest:jest",
        "options": {
          "jestConfig": "libs/blog/infrastructure/jest.integration.config.cts"
        }
      }
    }
  },
  "dependencies": {
    "@toxictoast/shared-kernel": "*",
    "@toxictoast/shared-persistence": "*",
    "@toxictoast/blog-domain": "*",
    "typeorm": "^1.1.2"
  }
}
