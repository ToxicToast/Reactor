HTTP_PORT=3001

KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=moderation-service
KAFKA_AUTO_CREATE_TOPICS=true
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICAS=1

NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=
NIM_MODEL=
NIM_TIMEOUT_MS=15000
NIM_MAX_TOKENS=1024
NIM_ENABLE_THINKING=false

MODERATION_APPROVE_THRESHOLD=0.95
MODERATION_SPAM_THRESHOLD=0.85
MODERATION_HATE_THRESHOLD=0.85
MODERATION_ACTOR_ID=<ID des Benutzers service-account-azkaban-agent-moderation>