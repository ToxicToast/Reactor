{
  "name": "@toxictoast/gateway",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "gateway",
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/gateway/dist/package.json",
          "{workspaceRoot}/apps/gateway/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/gateway/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "gateway:build",
          "runBuildTargetDependencies": false,
          "runtimeArgs": [
            "--env-file=apps/gateway/.env"
          ]
        },
        "configurations": {
          "development": {
            "buildTarget": "gateway:build:development"
          },
          "production": {
            "buildTarget": "gateway:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "docker-build": {
        "dependsOn": [
          "prune"
        ],
        "executor": "nx:run-commands",
        "options": {
          "VERSION": "local",
          "REGISTRY": "ghcr.io/toxictoast",
          "command": "docker build -f apps/gateway/Dockerfile -t {args.REGISTRY}/gateway:{args.VERSION} -t {args.REGISTRY}/gateway:latest apps/gateway/dist"
        }
      },
      "docker-push": {
        "executor": "nx:run-commands",
        "options": {
          "VERSION": "local",
          "REGISTRY": "ghcr.io/toxictoast",
          "parallel": false,
          "commands": [
            "docker push {args.REGISTRY}/gateway:{args.VERSION}",
            "docker push {args.REGISTRY}/gateway:latest"
          ]
        }
      }
    },
    "tags": [
      "scope:gateway",
      "type:app"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "@toxictoast/contracts-grpc": "*",
    "@toxictoast/contracts-proto": "*",
    "@toxictoast/shared-kernel": "*",
    "@toxictoast/shared-nest": "*",
    "@toxictoast/shared-system": "*",
    "@toxictoast/shared-types": "*",
    "@nestjs/microservices": "^12.0.0",
    "@nestjs/swagger": "^11.4.7",
    "@grpc/grpc-js": "^1.14.6",
    "jose": "^5.10.0",
    "nestjs-zod": "^5.5.0",
    "zod": "^4.6.7",
    "cookie": "^1.0.0",
    "http-proxy-middleware": "^3.0.0",
    "@toxictoast/contracts-events": "*",
    "@toxictoast/shared-messaging": "*"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0"
  }
}
