{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node"],
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../libs/twitch/infrastructure/tsconfig.lib.json"
    },
    {
      "path": "../../libs/twitch/domain/tsconfig.lib.json"
    },
    {
      "path": "../../libs/twitch/application/tsconfig.lib.json"
    },
    {
      "path": "../../libs/twitch/api/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/webhooks/application/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/persistence/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/nest/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/messaging/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/application/tsconfig.lib.json"
    },
    {
      "path": "../../libs/contracts/proto/tsconfig.lib.json"
    },
    {
      "path": "../../libs/contracts/events/tsconfig.lib.json"
    }
  ]
}
