{
  "name": "@toxictoast/audit-service",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "audit-service",
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/audit-service/dist/package.json",
          "{workspaceRoot}/apps/audit-service/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/audit-service/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "audit-service:build",
          "runBuildTargetDependencies": false,
          "runtimeArgs": [
            "--env-file=apps/audit-service/.env"
          ]
        },
        "configurations": {
          "development": {
            "buildTarget": "audit-service:build:development"
          },
          "production": {
            "buildTarget": "audit-service:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "docker-build": {
        "dependsOn": [
          "prune"
        ],
        "executor": "nx:run-commands",
        "options": {
          "VERSION": "local",
          "REGISTRY": "ghcr.io/toxictoast",
          "command": "docker build -f apps/audit-service/Dockerfile -t {args.REGISTRY}/audit-service:{args.VERSION} -t {args.REGISTRY}/audit-service:latest apps/audit-service/dist"
        }
      },
      "docker-push": {
        "executor": "nx:run-commands",
        "options": {
          "VERSION": "local",
          "REGISTRY": "ghcr.io/toxictoast",
          "parallel": false,
          "commands": [
            "docker push {args.REGISTRY}/audit-service:{args.VERSION}",
            "docker push {args.REGISTRY}/audit-service:latest"
          ]
        }
      }
    },
    "tags": [
      "scope:audit",
      "type:app"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "@toxictoast/audit-api": "*",
    "@toxictoast/audit-application": "*",
    "@toxictoast/audit-domain": "*",
    "@toxictoast/audit-infrastructure": "*",
    "@toxictoast/contracts-events": "*",
    "@toxictoast/contracts-proto": "*",
    "@toxictoast/shared-nest": "*",
    "@nestjs/microservices": "^11.2.7",
    "@grpc/grpc-js": "^1.14.6",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0"
  }
}
