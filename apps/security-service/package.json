{
  "name": "@toxictoast/security-service",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "security-service",
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/security-service/dist/package.json",
          "{workspaceRoot}/apps/security-service/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/security-service/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "security-service:build",
          "runBuildTargetDependencies": false,
          "runtimeArgs": [
            "--env-file=apps/security-service/.env"
          ]
        },
        "configurations": {
          "development": {
            "buildTarget": "security-service:build:development"
          },
          "production": {
            "buildTarget": "security-service:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      }
    },
    "tags": [
      "scope:security",
      "type:app"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "@toxictoast/contracts-events": "*",
    "@toxictoast/contracts-proto": "*",
    "@toxictoast/security-api": "*",
    "@toxictoast/security-application": "*",
    "@toxictoast/security-domain": "*",
    "@toxictoast/security-infrastructure": "*",
    "@toxictoast/shared-application": "*",
    "@toxictoast/shared-nest": "*",
    "@toxictoast/shared-persistence": "*",
    "@toxictoast/shared-system": "*",
    "@nestjs/microservices": "^11.2.7",
    "@grpc/grpc-js": "^1.14.6",
    "ioredis": "^5.11.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0"
  }
}
